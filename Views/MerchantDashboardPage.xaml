<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:SurplusEats.ViewModels"
             xmlns:model="clr-namespace:SurplusEats.Models"
             x:Class="SurplusEats.Views.MerchantDashboardPage"
             x:DataType="viewmodel:MerchantDashboardViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*" Padding="0">
        
        <!-- Statistics Header -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="*,*,*" 
              Padding="15" 
              BackgroundColor="#2E7D32">
            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                <Label Text="{Binding TotalProducts}" 
                       FontSize="24" 
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                <Label Text="Products" 
                       FontSize="12" 
                       TextColor="White"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
            
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                <Label Text="{Binding PendingOrders}" 
                       FontSize="24" 
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                <Label Text="Pending" 
                       FontSize="12" 
                       TextColor="White"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
            
            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                <Label Text="{Binding TotalRevenue, StringFormat='${0:F2}'}" 
                       FontSize="24" 
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                <Label Text="Revenue" 
                       FontSize="12" 
                       TextColor="White"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Tabs Content -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Padding="0">
            
            <!-- Tab Headers -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="15,10,15,0">
                <Button Grid.Column="0" 
                        Text="My Products" 
                        x:Name="ProductsTab"
                        BackgroundColor="#2E7D32"
                        TextColor="White"
                        CornerRadius="10"
                        Clicked="OnProductsTabClicked"/>
                <Button Grid.Column="1" 
                        Text="Orders" 
                        x:Name="OrdersTab"
                        BackgroundColor="White"
                        TextColor="#2E7D32"
                        CornerRadius="10"
                        Clicked="OnOrdersTabClicked"/>
            </Grid>

            <!-- Tab Content -->
            <Grid Grid.Row="1" x:Name="TabContent">
                
                <!-- Products Tab -->
                <Grid x:Name="ProductsContent" RowDefinitions="*,Auto" IsVisible="True">
                    <RefreshView Grid.Row="0" Command="{Binding LoadDataCommand}" IsRefreshing="{Binding IsBusy}">
                        <CollectionView ItemsSource="{Binding MyProducts}" Margin="15,0">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="model:Product">
                                    <Frame Padding="15" Margin="0,5" CornerRadius="10" BackgroundColor="White" HasShadow="True">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                                <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#333"/>
                                                <Label Text="{Binding CategoryName}" FontSize="12" TextColor="#666"/>
                                                <HorizontalStackLayout Spacing="10">
                                                    <Label Text="{Binding DiscountedPrice, StringFormat='${0:F2}'}" 
                                                           FontSize="16" 
                                                           FontAttributes="Bold"
                                                           TextColor="#2E7D32"/>
                                                    <Label Text="{Binding Quantity, StringFormat='Qty: {0}'}" 
                                                           FontSize="12" 
                                                           TextColor="#666"
                                                           VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" 
                                                    Text="Edit"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:MerchantDashboardViewModel}}, Path=EditProductCommand}" 
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#2196F3"
                                                    TextColor="White"
                                                    CornerRadius="5"
                                                    Padding="10,5"/>
                                            <Button Grid.Column="2" 
                                                    Text="Delete"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:MerchantDashboardViewModel}}, Path=DeleteProductCommand}" 
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#F44336"
                                                    TextColor="White"
                                                    CornerRadius="5"
                                                    Padding="10,5"/>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </RefreshView>

                    <Button Grid.Row="1"
                            Text="+ Add Product"
                            Command="{Binding AddProductCommand}"
                            BackgroundColor="#2E7D32"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="50"
                            FontSize="18"
                            FontAttributes="Bold"
                            Margin="15"/>
                </Grid>

                <!-- Orders Tab -->
                <RefreshView x:Name="OrdersContent" Command="{Binding LoadDataCommand}" IsRefreshing="{Binding IsBusy}" IsVisible="False">
                    <CollectionView ItemsSource="{Binding MyOrders}" Margin="15,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:Order">
                                <Frame Padding="15" Margin="0,5" CornerRadius="10" BackgroundColor="White" HasShadow="True">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                        <HorizontalStackLayout Grid.Row="0" Spacing="10">
                                            <Label Text="{Binding ProductName}" 
                                                   FontSize="16" 
                                                   FontAttributes="Bold" 
                                                   TextColor="#333"
                                                   HorizontalOptions="Start"/>
                                            <Label Text="{Binding Status}" 
                                                   FontSize="12" 
                                                   TextColor="White"
                                                   BackgroundColor="#2196F3"
                                                   Padding="5,2"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="End"/>
                                        </HorizontalStackLayout>
                                        <Label Grid.Row="1" 
                                               Text="{Binding ConsumerName, StringFormat='Customer: {0}'}" 
                                               FontSize="14" 
                                               TextColor="#666"/>
                                        <Label Grid.Row="2" 
                                               Text="{Binding Subtotal, StringFormat='Amount: ${0:F2}'}" 
                                               FontSize="14" 
                                               TextColor="#2E7D32"
                                               FontAttributes="Bold"/>
                                        <Button Grid.Row="3"
                                                Text="Update Status"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:MerchantDashboardViewModel}}, Path=UpdateOrderStatusCommand}" 
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#2E7D32"
                                                TextColor="White"
                                                CornerRadius="5"
                                                Padding="10,5"
                                                Margin="0,10,0,0"/>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>

            </Grid>
        </Grid>

    </Grid>

</ContentPage>

