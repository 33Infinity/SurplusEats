<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:SurplusEats.ViewModels"
             xmlns:model="clr-namespace:SurplusEats.Models"
             x:Class="SurplusEats.Views.AddProductPage"
             x:DataType="viewmodel:AddProductViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Add New Product" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#2E7D32" 
                   Margin="0,10,0,20"/>

            <!-- Product Name -->
            <Entry Placeholder="Product Name" Text="{Binding Name}"/>

            <!-- Description -->
            <Editor Placeholder="Description" 
                    Text="{Binding Description}"
                    HeightRequest="100"
                    AutoSize="TextChanges"/>

            <!-- Category Picker -->
            <Picker Title="Select Category"
                    ItemsSource="{Binding Categories}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedCategory}"/>

            <!-- Prices -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Entry Grid.Column="0" 
                       Placeholder="Original Price" 
                       Text="{Binding OriginalPriceText}"
                       Keyboard="Numeric"/>
                <Entry Grid.Column="1" 
                       Placeholder="Discounted Price" 
                       Text="{Binding DiscountedPriceText}"
                       Keyboard="Numeric"/>
            </Grid>

            <!-- Quantity -->
            <Entry Placeholder="Quantity Available" 
                   Text="{Binding QuantityText}"
                   Keyboard="Numeric"/>

            <!-- Expiry Date -->
            <Frame Padding="10" CornerRadius="5" BackgroundColor="White">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" 
                           Text="Expiry Date" 
                           VerticalOptions="Center"
                           TextColor="#666"/>
                    <DatePicker Grid.Column="1" 
                                Date="{Binding ExpiryDate}"/>
                </Grid>
            </Frame>

            <!-- Pickup Times -->
            <Frame Padding="10" CornerRadius="5" BackgroundColor="White">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Label Grid.Row="0" Grid.Column="0" 
                           Text="Pickup Start Time" 
                           VerticalOptions="Center"
                           TextColor="#666"/>
                    <TimePicker Grid.Row="0" Grid.Column="1" 
                                Time="{Binding PickupStartTime}"/>
                    
                    <Label Grid.Row="1" Grid.Column="0" 
                           Text="Pickup End Time" 
                           VerticalOptions="Center"
                           TextColor="#666"/>
                    <TimePicker Grid.Row="1" Grid.Column="1" 
                                Time="{Binding PickupEndTime}"/>
                </Grid>
            </Frame>

            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}" 
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"/>

            <!-- Save Button -->
            <Button Text="Add Product"
                    Command="{Binding SaveProductCommand}"
                    BackgroundColor="#2E7D32"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    FontSize="18"
                    FontAttributes="Bold"
                    Margin="0,20,0,0"/>

            <!-- Cancel Button -->
            <Button Text="Cancel"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="#999"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    FontSize="18"/>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                              IsVisible="{Binding IsBusy}"
                              Color="#2E7D32"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

