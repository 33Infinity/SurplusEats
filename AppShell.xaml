<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SurplusEats.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SurplusEats.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="SurplusEats">

    <!-- Login Page (Default) -->
    <ShellContent
        Route="Login"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- Consumer Home -->
    <ShellContent
        Route="ConsumerHome"
        ContentTemplate="{DataTemplate views:ConsumerHomePage}" />

    <!-- Merchant Dashboard -->
    <ShellContent
        Route="MerchantDashboard"
        ContentTemplate="{DataTemplate views:MerchantDashboardPage}" />

</Shell>
